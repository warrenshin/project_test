# docker compose up --build 실행에 필요한 환경변수 예시.
#
#   cp .env.example .env
#
# .env는 git에 커밋하지 않는다(.gitignore 참고). 아래 개발 기본값은 로컬/
# 스테이징에서 안전하게 그대로 쓸 수 있지만, "production 필수" 표시가 있는
# 값은 반드시 실제 값으로 바꿔야 한다 — 바꾸지 않으면 API가 기동 자체를
# 거부한다(apps/api/app/core/config.py의 Settings 검증기).
#
# apps/api, apps/web 각각을 Docker 없이(uvicorn --reload / npm run dev) 직접
# 실행할 때는 이 파일이 아니라 apps/api/.env.example, apps/web/.env.example을
# 쓴다 — 이 파일은 docker-compose 네트워크(서비스 이름으로 통신)를 기준으로
# 값이 맞춰져 있다.

ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=investment_learning
POSTGRES_PORT=5432

# --- API ---
# docker-compose 네트워크 안에서는 "postgres"/"redis"가 서비스 이름이자
# 호스트명이다 (localhost가 아니다 — localhost는 컨테이너 자기 자신을 뜻한다).
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/investment_learning
REDIS_URL=redis://redis:6379/0
API_PORT=8000

# production 필수: 반드시 무작위의 긴 값으로 교체 (예: openssl rand -hex 32)
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 인증 쿠키 정책 (HttpOnly — JavaScript는 값을 읽을 수 없다)
ACCESS_COOKIE_NAME=ilapp_access_token
REFRESH_COOKIE_NAME=ilapp_refresh_token
# production 필수: true (HTTPS 배포 전제 — false면 API가 기동을 거부한다)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 하위 도메인 공유가 실제로 필요할 때만 채운다. 미설정 = host-only 쿠키
# (더 안전한 기본값). 빈 문자열로 설정하지 말 것 — 주석 처리된 상태로 둔다.
# COOKIE_DOMAIN=.example.com
ACCESS_COOKIE_PATH=/
REFRESH_COOKIE_PATH=/v1/auth

# 상태변경 요청(POST/PUT/PATCH/DELETE)을 허용할 프런트엔드 origin. 쉼표로
# 구분된 명시적 목록만 허용한다(app/main.py, app/core/csrf.py 참고).
# production 필수: 실제 배포 도메인(반드시 https://)만 나열 — 와일드카드(*)
# 금지, allow_credentials=true와 와일드카드 조합은 브라우저 사양상으로도
# 허용되지 않는다.
CORS_ALLOWED_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000

DEFAULT_VIRTUAL_CASH_KRW=10000000
DEFAULT_BASE_CURRENCY=KRW
MARKET_DATA_STALENESS_THRESHOLD_SECONDS=900

# demo(외부 네트워크 없이 합성 데이터) | stooq(개발·기술검증 전용, production
# 불가 — apps/api/app/core/config.py 검증기 참고)
MARKET_DATA_PROVIDER=demo
CONCENTRATION_WARNING_THRESHOLD_PCT=30

# 실제 LLM 연동 (7.5-7.7). 비워두면 규칙 기반 graceful degradation 경로로만
# 동작한다 — 이번 staging 준비 범위에서는 라이브 LLM 연결을 하지 않으므로
# 비워둔 채로 둔다. 실제 키 값을 이 예시 파일이나 문서에 절대 적지 말 것.
ANTHROPIC_API_KEY=
AI_COACH_SIMPLE_MODEL=claude-haiku-4-5
AI_COACH_COMPLEX_MODEL=claude-sonnet-5
AI_COACH_PROMPT_VERSION=v1

# 실시간 시장 데이터 공급자는 아직 연동돼 있지 않다(이번 범위에서 의도적으로
# 다루지 않음). 앱은 항상 Alembic 시드 마이그레이션으로 들어간 데모 4종목
# (삼성전자/SK하이닉스/AAPL/MSFT)의 정적 시세만 사용하는 "데모 모드"로
# 동작한다 — 별도 설정 플래그는 없다. apps/api/README.md 참고.

# --- Web ---
WEB_PORT=3000
# 브라우저가 "직접" 호출하는 API 주소 — 컨테이너 내부 주소(http://api:8000)가
# 아니라 반드시 브라우저(호스트 PC)에서 접근 가능한 주소를 적는다. Next.js는
# 이 값을 빌드 시점에 클라이언트 번들에 그대로 굳혀 넣으므로(공개 설정이며
# 비밀정보 아님) 주소가 바뀌면 web 이미지를 다시 빌드해야 한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
