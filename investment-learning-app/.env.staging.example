# 로컬 스테이징 전용 환경변수 예시 파일.
#
# 사용법:
#   cp .env.staging.example .env.staging
#   (필요하면 값을 수정한다 — 아래 SECRET 표시된 항목은 실제 배포 전 반드시 교체)
#
# 주의:
# - 이 파일(.env.staging.example)만 저장소에 커밋한다. 실제 값이 든
#   `.env.staging`은 .gitignore에 등록돼 있고 절대 커밋해서는 안 된다.
# - 여기 적힌 값은 전부 "로컬 스테이징(로컬 Docker Compose)" 전용
#   플레이스홀더다. 실제 클라우드 스테이징/운영에 그대로 쓰면 안 된다.
# - 이 파일에도, 어떤 문서에도, 실제 비밀값(진짜 API 키·JWT 시크릿 등)을
#   적지 않는다.

# --- 환경 식별 ---
# 이 저장소의 실제 환경 감지 필드는 app/core/config.py의 Settings.environment
# (env var 이름 ENVIRONMENT)이며, production 안전 검증 validator가 이미 이
# 값을 기준으로 동작한다. 별도로 기능이 없는 APP_ENV 변수를 새로 추가하는
# 대신 기존 메커니즘을 "staging" 값으로 확장했다 — 상세 사유는 README 참고.
ENVIRONMENT=staging

# --- Postgres (staging 전용 — dev/운영 DB와 절대 공유 금지) ---
POSTGRES_USER=staging_app
POSTGRES_PASSWORD=staging_app_local_only
POSTGRES_DB=investment_learning_staging

# api 컨테이너 기준 내부 네트워크 호스트명은 반드시 staging-postgres여야
# 한다(docker-compose.staging.yml의 네트워크 별칭). config.py의 staging
# 안전 검증이 이 호스트명을 확인해, dev의 `postgres`나 실제 운영 DB
# 호스트를 가리키면 기동을 거부한다.
DATABASE_URL=postgresql+psycopg://staging_app:staging_app_local_only@staging-postgres:5432/investment_learning_staging

REDIS_URL=redis://staging-redis:6379/0

# --- 포트(호스트) ---
STAGING_API_PORT=8001
STAGING_WEB_PORT=3001
# postgres는 기본적으로 호스트 포트를 노출하지 않는다(디버깅에 필요할 때만
# 로컬호스트 전용으로 5433을 연다 — docker-compose.staging.yml 참고 주석).

# --- JWT / 쿠키 ---
# SECRET: 아래 값은 예시 플레이스홀더다 — 실행 전 반드시 무작위값으로 교체할 것.
# 이 예시값을 그대로 두면 app/core/config.py의 staging 안전 검증이 기동 자체를
# 거부한다("change-me" 패턴 탐지 + 16자 미만 거부). 예: openssl rand -hex 32
JWT_SECRET=staging-local-placeholder-change-me-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# COOKIE_SECURE=false는 "로컬 스테이징(순수 로컬 HTTP)"에서만 허용되는
# 예외다 — 절대로 인터넷에 노출하지 말 것(never expose to the internet).
# 실제 클라우드 스테이징(HTTPS로 서빙되는 환경)에서는 반드시
# COOKIE_SECURE=true, COOKIE_SAMESITE=lax 이상이어야 하며, 이 로컬 전용
# 예외와 절대 혼동하면 안 된다. app/core/config.py의 staging 안전 검증은
# COOKIE_SECURE=false를 "로컬 스테이징"으로만 취급하고, 아래
# STAGING_ALLOW_INSECURE_COOKIE=true가 함께 설정돼 있지 않으면 거부한다
# (실수로 안전하지 않은 값이 클라우드에 배포되는 것을 막기 위한 이중 확인).
COOKIE_SECURE=false
STAGING_ALLOW_INSECURE_COOKIE=true
COOKIE_SAMESITE=lax

# --- CORS ---
# 로컬 스테이징 웹 프런트(staging-web, 호스트 포트 3001)만 허용한다.
CORS_ALLOWED_ORIGINS_RAW=http://localhost:3001,http://127.0.0.1:3001

# --- 프런트엔드가 브라우저에서 호출할 API 주소 ---
# 브라우저(호스트)에서 접근 가능한 주소여야 한다(컨테이너 내부 주소 아님) —
# 빌드 시점에 클라이언트 번들에 굳어 박힌다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# --- 도메인 기본값 ---
DEFAULT_VIRTUAL_CASH_KRW=10000000
DEFAULT_BASE_CURRENCY=KRW
MARKET_DATA_STALENESS_THRESHOLD_SECONDS=86400
MARKET_DATA_PROVIDER=demo
CONCENTRATION_WARNING_THRESHOLD_PCT=30

# --- AI 코치 (실제 키를 절대 적지 말 것 — 비워두면 규칙 기반 폴백으로 동작한다) ---
ANTHROPIC_API_KEY=
AI_COACH_SIMPLE_MODEL=claude-haiku-4-5
AI_COACH_COMPLEX_MODEL=claude-sonnet-5
AI_COACH_PROMPT_VERSION=v1

# --- 게시 스크립트가 참조하는 안전장치용 값 (아래 항목은 코드 값이 아니라
# 사람이 눈으로 dev DB와 헷갈리지 않도록 표시하는 라벨용이다) ---
STAGING_LABEL=local-staging-do-not-expose
