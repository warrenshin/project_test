ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/investment_learning
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 인증 쿠키(HttpOnly, JS에서 읽을 수 없음). 이름은 변경 가능하지만 두 값이
# 겹치면 안 된다. 개발환경 기본값은 HTTP localhost에서 동작하도록
# COOKIE_SECURE=false이며, production에서는 반드시 true로 재정의해야 한다
# (그렇지 않으면 앱이 기동을 거부한다 — app/core/config.py 참고).
ACCESS_COOKIE_NAME=ilapp_access_token
REFRESH_COOKIE_NAME=ilapp_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 하위 도메인 공유가 실제로 필요할 때만 이 줄의 주석을 풀고 채운다.
# (미설정 = host-only 쿠키, 더 안전한 기본값 — 빈 문자열로 설정하지 말 것)
# COOKIE_DOMAIN=.example.com
ACCESS_COOKIE_PATH=/
REFRESH_COOKIE_PATH=/v1/auth

DEFAULT_VIRTUAL_CASH_KRW=10000000
DEFAULT_BASE_CURRENCY=KRW

MARKET_DATA_STALENESS_THRESHOLD_SECONDS=900
CONCENTRATION_WARNING_THRESHOLD_PCT=30

# 비워두면 AI 코치가 규칙 기반 graceful degradation 경로로만 동작한다 (7.7)
ANTHROPIC_API_KEY=
AI_COACH_SIMPLE_MODEL=claude-haiku-4-5
AI_COACH_COMPLEX_MODEL=claude-sonnet-5
AI_COACH_PROMPT_VERSION=v1
